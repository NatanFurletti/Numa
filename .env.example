# Supabase (ranking do teste do dia, D-031). Copie para .env.local e preencha.
# No painel do Supabase, em API Keys: use a chave publicável (sb_publishable_...), nunca a secreta.
# Sem estas variáveis o app funciona, mas o ranking fica indisponível.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço das funções do servidor (api/, D-034), sem barra no fim. Na web publicada não precisa:
# as funções ficam no mesmo endereço do site. Preencha para o `npm run web` local (que não tem
# as funções) e para os apps nativos. Ex.: o endereço de homologação.
EXPO_PUBLIC_API_URL=

# Só no servidor (variáveis do projeto na Vercel, nunca no app): a chave secreta do Supabase
# (sb_secret_...), usada pelas funções de api/ para gravar depois de conferir as respostas.
# Sem ela, as funções respondem 503 e nada é enviado.
# SUPABASE_SECRET_KEY=
