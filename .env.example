# Supabase (ranking do teste do dia, D-031). Copie para .env.local e preencha.
# No painel do Supabase, em API Keys: use a chave publicável (sb_publishable_...), nunca a secreta.
# Sem estas variáveis o app funciona, mas o ranking fica indisponível.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
